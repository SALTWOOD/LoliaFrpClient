<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!--
          共享库,不再产出可执行文件:桌面宿主在 LoliaFrpClient.Desktop,移动端宿主在
          LoliaFrpClient.Android。三个头共用这一份界面与视图模型。

          AssemblyName 保持 LoliaFrpClient,App.axaml 里的
          avares://LoliaFrpClient/Styles/Tokens.axaml 因此不受影响。
        -->
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <RootNamespace>LoliaFrpClient</RootNamespace>
        <AssemblyName>LoliaFrpClient</AssemblyName>
        <!--
          默认使用编译绑定而非反射绑定。反射绑定在 NativeAOT / 裁剪下会触发 IL2026,
          且失效方式是静默的(绑定不到就显示空白,不报错)。开启后每个绑定作用域都必须
          声明 x:DataType,漏写会在编译期直接报错。
        -->
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Models\"/>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3"/>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageReference Include="FluentAvaloniaUI" Version="3.1.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\LoliaFrpClient.Core\LoliaFrpClient.Core.csproj"/>
        <ProjectReference Include="..\LoliaFrpClient.Api\LoliaFrpClient.Api.csproj"/>
    </ItemGroup>
</Project>
