<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LoliaFrpClient.ViewModels"
             x:Class="LoliaFrpClient.Views.FrpcManagerPage"
             x:DataType="vm:FrpcManagerViewModel">

    <Grid RowDefinitions="Auto,*" Margin="{DynamicResource PagePadding}">

        <!-- ── 标题 + frpc 核心状态 ── -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBlock Grid.Column="0" Text="Frpc 管理" Classes="pageTitle" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Classes="caption" VerticalAlignment="Center">
                    <Run Text="核心版本"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding FrpcVersion}"/>
                </TextBlock>
                <!-- TODO: 接入 frpc 下载 / 安装 / 更新 -->
                <Button Content="安装 / 更新"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="260,*" ColumnSpacing="16">

            <!-- ── 左:进程列表 ── -->
            <Border Grid.Column="0" Classes="card" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="进程" Classes="sectionTitle" Margin="16,14,16,8"/>
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Processes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FrpcProcessEntry">
                                    <Border Padding="16,10" Background="Transparent">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Ellipse Grid.Column="0"
                                                     Classes="statusDot"
                                                     Classes.online="{Binding IsOnline}"
                                                     Classes.offline="{Binding IsOffline}"
                                                     Classes.starting="{Binding IsStarting}"
                                                     Classes.error="{Binding IsError}"/>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{Binding Tunnel}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding StatusText}" Classes="caption"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding RemotePort}"
                                                       Classes="caption"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ── 右:控制 + 日志 ── -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="16">

                <Border Grid.Row="0" Classes="card">
                    <StackPanel Spacing="{DynamicResource SpaceMd}">
                        <TextBlock Text="控制" Classes="sectionTitle"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- TODO: 接入 FrpcManager 的启停 -->
                            <Button Content="启动全部"/>
                            <Button Content="停止全部"/>
                            <Button Content="重启"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Classes="card">
                    <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource SpaceMd}">
                        <TextBlock Grid.Row="0" Text="日志" Classes="sectionTitle"/>
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding LogLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"
                                                   FontSize="12"
                                                   TextWrapping="NoWrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
