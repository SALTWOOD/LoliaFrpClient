<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:LoliaFrpClient.ViewModels"
             x:Class="LoliaFrpClient.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <!--
          四组设置用的是同一个「左标签、右取值」的行,提成一个模板免得写四遍。
          标签列宽在窄屏收窄:180dp 在 360dp 屏上会把 url 之类的长值挤成三行。
        -->
        <DataTemplate x:Key="SettingsRow" x:DataType="vm:SettingsEntry">
            <Grid ColumnSpacing="12" Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).IsCompact, Converter={StaticResource CompactValue}, ConverterParameter='180|92'}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="caption" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Padding="{DynamicResource PagePadding}">
        <StackPanel Spacing="{DynamicResource SpaceXl}" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="设置" Classes="pageTitle" />

            <!-- ── 账户 ── -->
            <ui:FASettingsExpander Header="账户" IsExpanded="True">
                <StackPanel Spacing="{DynamicResource SpaceMd}">
                    <ItemsControl ItemsSource="{Binding Account}" ItemTemplate="{StaticResource SettingsRow}" />
                    <!-- 登录走 OAuth 授权码 + PKCE:会打开系统浏览器,期间本窗口只等待回调。 -->
                    <TextBlock Text="{Binding StatusMessage}"
                               Classes="caption"
                               IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="登录" Classes="accent"
                                Command="{Binding SignInCommand}"
                                IsVisible="{Binding !IsSignedIn}" />
                        <Button Content="登出"
                                Command="{Binding SignOutCommand}"
                                IsVisible="{Binding IsSignedIn}" />
                        <ProgressBar IsIndeterminate="True"
                                     Width="140"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsBusy}" />
                    </StackPanel>
                </StackPanel>
            </ui:FASettingsExpander>

            <!-- ── 外观 ── -->
            <ui:FASettingsExpander Header="外观">
                <StackPanel Spacing="{DynamicResource SpaceMd}">
                    <ItemsControl ItemsSource="{Binding Appearance}" ItemTemplate="{StaticResource SettingsRow}" />
                    <!-- TODO: 接入主题切换 -->
                    <ComboBox SelectedIndex="0" HorizontalAlignment="Left" MinWidth="160">
                        <ComboBoxItem Content="跟随系统" />
                        <ComboBoxItem Content="浅色" />
                        <ComboBoxItem Content="深色" />
                    </ComboBox>
                </StackPanel>
            </ui:FASettingsExpander>

            <!-- ── Frpc 核心 ── -->
            <ui:FASettingsExpander Header="Frpc 核心">
                <StackPanel Spacing="{DynamicResource SpaceMd}">
                    <ItemsControl ItemsSource="{Binding FrpcCore}" ItemTemplate="{StaticResource SettingsRow}" />
                    <!-- 内置 frpc 时这三个都无意义:换不了,也用不着装。 -->
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8"
                               IsVisible="{Binding CanManageFrpc}">
                        <Button Content="指定路径" Command="{Binding PickFrpcPathCommand}" />
                        <Button Content="安装 / 更新" Command="{Binding InstallFrpcCommand}" />
                        <Button Content="卸载" Command="{Binding UninstallFrpcCommand}" />
                    </WrapPanel>
                    <Button Content="前往 Frpc 管理" Command="{Binding OpenFrpcManagerCommand}" />
                </StackPanel>
            </ui:FASettingsExpander>

            <!-- ── 关于 ── -->
            <ui:FASettingsExpander Header="关于">
                <ItemsControl ItemsSource="{Binding About}" ItemTemplate="{StaticResource SettingsRow}" />
            </ui:FASettingsExpander>

        </StackPanel>
    </ScrollViewer>
</UserControl>