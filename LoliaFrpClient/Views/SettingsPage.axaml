<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:LoliaFrpClient.ViewModels"
             x:Class="LoliaFrpClient.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer Padding="{DynamicResource PagePadding}">
        <StackPanel Spacing="{DynamicResource SpaceXl}" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="设置" Classes="pageTitle"/>

            <!-- ── 账户 ── -->
            <ui:FASettingsExpander Header="账户" IsExpanded="True">
                <StackPanel Spacing="{DynamicResource SpaceMd}">
                    <ItemsControl ItemsSource="{Binding Account}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingsEntry">
                                <Grid ColumnDefinitions="180,*" Margin="0,4">
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="caption"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- TODO: 接入 User.LoginAsync() 与 OAuth 回调 -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="登录" Classes="accent"/>
                        <Button Content="登出"/>
                    </StackPanel>
                </StackPanel>
            </ui:FASettingsExpander>

            <!-- ── 外观 ── -->
            <ui:FASettingsExpander Header="外观">
                <StackPanel Spacing="{DynamicResource SpaceMd}">
                    <ItemsControl ItemsSource="{Binding Appearance}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingsEntry">
                                <Grid ColumnDefinitions="180,*" Margin="0,4">
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="caption"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- TODO: 接入主题切换 -->
                    <ComboBox SelectedIndex="0" HorizontalAlignment="Left" MinWidth="160">
                        <ComboBoxItem Content="跟随系统"/>
                        <ComboBoxItem Content="浅色"/>
                        <ComboBoxItem Content="深色"/>
                    </ComboBox>
                </StackPanel>
            </ui:FASettingsExpander>

            <!-- ── Frpc 核心 ── -->
            <ui:FASettingsExpander Header="Frpc 核心">
                <StackPanel Spacing="{DynamicResource SpaceMd}">
                    <ItemsControl ItemsSource="{Binding FrpcCore}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingsEntry">
                                <Grid ColumnDefinitions="180,*" Margin="0,4">
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="caption"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- TODO: 接入 frpc 下载 / 安装 / 卸载 -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="安装"/>
                        <Button Content="检查更新"/>
                        <Button Content="卸载"/>
                    </StackPanel>
                </StackPanel>
            </ui:FASettingsExpander>

            <!-- ── 关于 ── -->
            <ui:FASettingsExpander Header="关于">
                <ItemsControl ItemsSource="{Binding About}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsEntry">
                            <Grid ColumnDefinitions="180,*" Margin="0,4">
                                <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="caption"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:FASettingsExpander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
