<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LoliaFrpClient.ViewModels"
        x:Class="LoliaFrpClient.Views.TunnelDetailWindow"
        x:DataType="vm:TunnelDetailViewModel"
        Title="隧道详情"
        Width="520"
        Height="620"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="16">

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="{Binding Title}" Classes="sectionTitle" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Detail.Name}" Classes="caption" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DetailRow">
                        <Grid ColumnDefinitions="140,*" Margin="0,5">
                            <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="caption" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="{DynamicResource SpaceMd}">

            <StackPanel Spacing="4">
                <TextBlock Text="备注" Classes="caption" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding Remark}" PlaceholderText="可留空" />
                    <Button Grid.Column="1" Content="保存" Command="{Binding SaveRemarkCommand}" />
                </Grid>
            </StackPanel>

            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}" />

            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Text="{Binding StatusMessage}"
                       IsVisible="{Binding HasStatus}" />

            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />

            <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0"
                        Content="删除隧道"
                        HorizontalAlignment="Left"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Command="{Binding RequestDeleteCommand}" />
                <Button Grid.Column="1" Content="关闭" Command="{Binding CloseCommand}" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>